# =============================================================================
# Microsoft Tech Day — Innovate with Azure AI Optimized Databases
# Environment variables template
# =============================================================================
# Copy this file to .env and fill in your actual values.
#   cp .env.example .env
# !! Never commit the .env file !!
# =============================================================================

# ---------------------------------------------------------------------------
# Azure SQL Database
# ---------------------------------------------------------------------------
SQL_SERVER=<your-server>.database.windows.net
SQL_DATABASE=TechDayDemo
# Connection string used by Data API Builder (L200 demo)
DATABASE_CONNECTION_STRING=Server=<your-server>.database.windows.net;Database=TechDayDemo;Authentication=Active Directory Default;

# ---------------------------------------------------------------------------
# Azure OpenAI
# ---------------------------------------------------------------------------
# The resource name portion of your Azure OpenAI endpoint
# e.g. if your endpoint is https://myoai.openai.azure.com, enter: myoai
AOAI_ENDPOINT=<your-aoai-resource-name>

# API key for Azure OpenAI (used in DATABASE SCOPED CREDENTIAL)
AOAI_KEY=<your-azure-openai-api-key>

# Embedding model deployment name (e.g. text-embedding-ada-002 or text-embedding-3-small)
EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# Chat model deployment name (e.g. gpt-4o) — used in L300 RAG demo
CHAT_DEPLOYMENT=gpt-4o
